{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["hardhat.config.ts", "contracts/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "agents/**/*.ts"],
  "exclude": ["node_modules", "src"]
}
